{
  "name": "home-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run build",
    "build": "npm run test && npm run build:app",
    "build:app": "tsc -b && vite build",
    "release:web": "npm run build",
    "preview": "vite preview",
    "sprites:sync": "node scripts/sync-pokemon-sprites.mjs",
    "species:sync": "node scripts/sync-species-rules.mjs",
    "events:sync": "node scripts/sync-serebii-events.mjs",
    "home-challenges:sync": "node scripts/sync-home-challenges.mjs"
  },
  "dependencies": {
    "fflate": "0.7.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
